# MongoDB connection string (replace with your actual MongoDB URI)
MONGODB_URI=mongodb://localhost:27017/nova_ecommerce

# JWT secret for signing tokens (generate a strong random string in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Server port (default 3000)
PORT=3000

# Base URL for serving uploaded images (leave as-is for local dev)
BASE_URL=http://localhost:3000

# Admin seed script (optional — used by npm run seed)
ADMIN_EMAIL=admin@nova.style
ADMIN_PASSWORD=admin123
ADMIN_NAME=Admin
