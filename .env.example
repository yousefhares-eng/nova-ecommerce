# MongoDB connection string (replace with your actual MongoDB URI)
MONGODB_URI=mongodb://localhost:27017/nova_ecommerce

# JWT secret for signing tokens (generate a strong random string in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Server port (default 3000)
PORT=3000

# Base URL for serving uploaded images (leave as-is for local dev)
BASE_URL=http://localhost:3000

# Local project data goes to D:\\NOVA-data when the D: drive exists.
# Override this path when deploying or using another data drive.
NOVA_DATA_DIR=D:\\NOVA-data

# Admin seed script (optional — used by npm run seed)
ADMIN_EMAIL=admin@nova.style
ADMIN_PASSWORD=admin123
ADMIN_NAME=Admin

# Optional AI panel keys. Never commit real keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
